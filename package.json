{
  "name": "@swarmai/meeting-bridge",
  "version": "0.1.0",
  "description": "SwarmAI plugin: connects the CEO Agent to a SwarmAI Meeting Hub so external guests can join meetings as human-external attendees.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "swarmai-package.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@swarmai/plugin-sdk": ">=0.5.0",
    "@swarmai/shared": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@swarmai/plugin-sdk": { "optional": false },
    "@swarmai/shared": { "optional": false }
  },
  "dependencies": {
    "ws": "^8.20.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "NorthPeak <ops@northpeak.app>",
  "repository": {
    "type": "git",
    "url": "https://github.com/northpeakmalaysia/meeting-bridge"
  },
  "homepage": "https://hub.northpeak.app",
  "engines": {
    "node": ">=22.0.0"
  }
}
